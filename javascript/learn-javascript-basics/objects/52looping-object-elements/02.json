    {
      "type": "code",
      "language": "javascript",
      "content": "1const book = {\n2    title: \"The Hobbit\",\n3    author: \"J.R.R. Tolkien\",\n4    pages: 295,\n5    year: 1937\n6};\n7\n8// Loop through the object\n9for (let key in book) {\n10    console.log(`${key}: ${book[key]}`);\n11}"
    },
