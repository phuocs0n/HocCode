    {
      "type": "code",
      "language": "html",
      "content": "1<div class=\"main-layout-container\">\n2  <aside class=\"sidebar\">Sidebar</aside>\n3  <main class=\"content\">\n4    <h1>Main Content</h1>\n5    <p>This layout uses flexbox to place the sidebar and content side by side.</p>\n6  </main>\n7</div>"
    },
