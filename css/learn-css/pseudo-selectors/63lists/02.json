      "type": "code",
      "language": "html",
      "content": "1<ul class=\"square\">\n2    <li>Apple</li>\n3    <li>Ball</li>\n4    <li>Cat</li>\n5</ul>"
    },
    {
      "type": "code",
      "language": "css",
      "content": "1ul.square {\n2    list-style-type: square;    /* Adds square bullets */\n3}"
