      "type": "code",
      "language": "cpp",
      "content": "1#include <iostream>\n2using namespace std;\n3\n4int fib(int n) {\n5\n6    // base case \n7    // if number is 1 or 0, return it\n8    if (n == 0 || n == 1) {\n9        return n;\n10    }\n11    \n12    // return the sum of the previous two fibonacci numbers\n13    return fib(n - 1) + fib(n - 2);\n14}\n15\n16int main() {\n17\n18    int result = fib(4);\n19    cout << result;\n20\n21    return 0;\n22}"
    },
