    },
    {
      "type": "paragraph",
      "content": "Let's slightly modify the program we previously wrote."
    },
    {
      "type": "code",
      "language": "cpp",
      "content": "1#include <iostream>\n2using namespace std;\n3\n4int main() {\n5\n6    int floors[2] = {1, 2};\n7    char apartments[3] = {'A', 'B', 'C'};\n8\n9    for (int i = 0; i < 2; ++i) {\n10\n11        for (int j = 0; j < 3; ++j) {\n12            cout << floors[i] << apartments[j] << endl;\n13        }\n14\n15        cout << \"-----\" << endl;\n16    }\n17\n18    return 0;\n19}"
    },
    {
      "type": "paragraph",
      "content": "Output"
    },
    {
      "type": "code",
      "language": "text",
      "content": "1A\n1B\n1C\n------\n2A\n2B\n2C\n------"
    },
    {
      "type": "paragraph",
      "content": "In the program, the cout << \"-----\" << endl; statement is outside the inner loop."
    },
    {
      "type": "image",
      "alt": "The inner for loop is executed for each iteration of the outer loop.",
      "src": "data:image/png;base64,"
    },
    {
      "type": "paragraph",
      "content": "Here, for each iteration of the outer loop, this code is executed:"
    },
    {
      "type": "code",
      "language": "cpp",
      "content": "for (int j = 0; j < 3; ++j) {\n    cout << floors[i] << apartments[j] << endl;\n}\n\ncout << \"-----\" << endl;\n}"
    },
