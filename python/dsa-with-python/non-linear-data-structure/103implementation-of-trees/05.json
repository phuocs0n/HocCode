      "alt": "Adding the Three Children of Root",
      "src": "data:image/png;base64,"
    },
    {
      "type": "paragraph",
      "content": "Let's add this relationship using the add_child() method."
    },
    {
      "type": "code",
      "language": "python",
      "content": "root.add_child(child1)\nroot.add_child(child2)\nroot.add_child(child3)"
    },
    {
      "type": "heading",
      "level": 3,
      "content": "Defining Relationships of Leaf Nodes"
    },
    {
      "type": "paragraph",
      "content": "i. Children of child1"
    },
    {
      "type": "code",
      "language": "python",
      "content": "# add four children to the child1 node\nchild1.add_child(child1_1)\nchild1.add_child(child1_2)\nchild1.add_child(child1_3)\nchild1.add_child(child1_4)"
    },
    {
      "type": "paragraph",
      "content": "ii. Children of child2"
    },
    {
      "type": "code",
      "language": "python",
      "content": "# add a child of child2 node\nchild2.add_child(child2_1)"
    },
    {
      "type": "paragraph",
      "content": "iii. Children of child3"
    },
    {
      "type": "code",
      "language": "python",
      "content": "# add three children to the child3 node\nchild3.add_child(child3_1)\nchild3.add_child(child3_2)\nchild3.add_child(child3_3)"
    },
