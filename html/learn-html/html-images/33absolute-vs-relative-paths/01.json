    {
      "type": "paragraph",
      "content": "An absolute path provides the complete URL to a resource. For example,"
    },
    {
      "type": "code",
      "language": "html",
      "content": "https://programiz.pro/learn/master-python"
    },
    {
      "type": "paragraph",
      "content": "It includes"
    },
    {
      "type": "bullet_list",
      "items": [
        "Protocol (http:// or https://)",
        "Domain name (programiz.pro)",
        "Directory path (learn/master-python)"
      ]
    },
    {
      "type": "paragraph",
      "content": "Let's see an example of using absolute path with the <a> tag."
    },
    {
      "type": "code",
      "language": "html",
      "content": "1<a href=\"https://programiz.pro/learn/master-python\" title=\"Python Course\" target=\"_blank\">Python Course</a>"
